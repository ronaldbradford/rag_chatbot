# Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Any OpenRouter chat model ID: https://openrouter.ai/models
CHAT_MODEL=anthropic/claude-sonnet-5.5

# Any OpenRouter embedding model ID: https://openrouter.ai/models?output_modalities=embeddings
EMBEDDING_MODEL=openai/text-embedding-3-small
# Must match the embedding model's vector size (text-embedding-3-small = 1536,
# text-embedding-3-large = 3072). If you change the model, uploaded documents are
# marked "needs re-index". If the size changes too, stored vectors are cleared
# and the SVECTOR column is recreated. vsql_vector allows at most 3072 dimensions.
# This build has no HNSW index; search is an exact scan.
EMBEDDING_DIM=1536

DATABASE_URL=mysql+aiomysql://rag:rag@127.0.0.1:3306/rag?charset=utf8mb4
